---
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonld?: object[];
  scholar?: Record<string, string | string[]>;
}
const { lang, title, description, noindex, ogType, jsonld, scholar } = Astro.props;
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F5F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} lang={lang} noindex={noindex} ogType={ogType} jsonld={jsonld} scholar={scholar} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
