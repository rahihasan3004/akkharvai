---
/** One publication in an editorial list. All fields must be verified facts. */
interface Props {
  title: string;
  href: string;
  authors: string;
  date: string;       // display string, already localised
  type: string;       // e.g. "Preprint", "Specification"
  doi?: string;
  extra?: { label: string; href: string }[];
  note?: string;
}
const { title, href, authors, date, type, doi, extra = [], note } = Astro.props;
---
<article class="pub">
  <p class="meta line1"><span>{date}</span><span aria-hidden="true"> · </span><span>{type}</span></p>
  <h3 class="title"><a href={href}>{title}</a></h3>
  <p class="authors">{authors}</p>
  <p class="meta ids">
    {doi && <a href={`https://doi.org/${doi}`}>DOI {doi}</a>}
    {extra.map((e) => <a href={e.href}>{e.label}</a>)}
  </p>
  {note && <p class="meta">{note}</p>}
</article>

<style>
  .pub { padding-block: var(--s-5); border-bottom: var(--hairline); }
  .title { font-size: var(--fs-4); line-height: 1.3; margin-block: var(--s-1) var(--s-2); }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { color: var(--green); text-decoration: underline; text-decoration-thickness: 1px; }
  .authors { font-size: var(--fs-2); }
  .ids { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); margin-top: var(--s-2); }
</style>
