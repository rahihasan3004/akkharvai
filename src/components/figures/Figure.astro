---
/** Figure wrapper: numbered caption and a source line. */
interface Props { caption: string; source?: string; sourceHref?: string; wide?: boolean; id?: string }
const { caption, source, sourceHref, wide = false, id } = Astro.props;
---
<figure class:list={['fig', { wide }]} id={id}>
  <div class="fig-body" tabindex="0" role="region" aria-label={caption}><slot /></div>
  <figcaption>
    <span class="cap">{caption}</span>
    {source && <span class="src">{sourceHref ? <a href={sourceHref}>{source}</a> : source}</span>}
  </figcaption>
</figure>
<style>
  .fig { margin-block: var(--s-6); }
  .fig-body { border-top: 1px solid var(--ink); border-bottom: var(--hairline); padding-block: var(--s-5); overflow-x: auto; }
  figcaption { font-family: var(--font-sans); font-size: var(--fs-1); color: var(--ink-2); margin-top: var(--s-2); display: flex; flex-direction: column; gap: var(--s-1); max-width: var(--measure); }
  .cap { color: var(--ink); }
</style>
